# ─────────────────────────────────────────────────────────────
# PageFetch  environment variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Proxy credentials — pick the provider you use.
#
# Schemes accepted:  http | https | socks5 | socks5h

# ── Standard (self-hosted / datacenter) proxy ───────────────
# Use this for any HTTP, HTTPS, or SOCKS5 proxy you control
# or rent.  Credentials are optional; omit them for
# unauthenticated proxies.
# CUSTOM_PROXY_URL=socks5://user:pass@proxy.example.com:1080

# ── Residential proxy provider (Decodo) ─────────────────────
# Full proxy URL including username and password:
# DECODO_PROXY_URL=http://username:password@host:port

# ── Residential proxy provider (Byteful) ────────────────────
# Full proxy URL including username and password. Byteful's
# residential backconnect gateway lives at residential.byteful.com:8000.
# BYTEFUL_PROXY_URL=https://username:password@residential.byteful.com:8000

# Auto-install behaviour (set to 0 / false / no / off to disable)
# PAGEFETCH_AUTO_INSTALL=1
