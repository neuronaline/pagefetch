# ─────────────────────────────────────────────────────────────
# PageFetch  environment variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Proxy provider credentials — pick the provider you use.
# You can provide a full URL or individual parts.

# Option A: Full proxy URL (recommended)
# DECODO_PROXY_URL=http://username:password@host:port
# DATAIMPULSE_PROXY_URL=http://username:password@host:port

# Option B: Individual components
# DECODO_HOST=proxy.example.com
# DECODO_PORT=8080
# DECODO_USERNAME=your_username
# DECODO_PASSWORD=your_password

# Auto-install behaviour (set to 0 / false / no / off to disable)
# PAGEFETCH_AUTO_INSTALL=1
