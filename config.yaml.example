# ─────────────────────────────────────────────────────────────
# PageFetch  configuration  (copy to  config.yaml  and edit)
# ─────────────────────────────────────────────────────────────
#
# Values support  ${ENV_VAR}  and  ${ENV_VAR:default}  syntax.
# Environment variables are resolved from  .env  or the shell.
# ─────────────────────────────────────────────────────────────

# Fetching mode:  auto  (try HTTP first, fall back to browser),
#                 http  (HTTP only),  browser  (browser only)
mode: auto

# Confidence threshold (0.0 – 1.0) for deciding whether HTTP
# content is usable or a browser fallback is needed.
confidence_threshold: 0.80

# How aggressively to strip non-content DOM before extraction.
#   minimal  — only universally safe rules (display:none, hidden, 1×1 pixels)
#   standard — also drops cookie banners, ad slots, tracking pixels (default)
#   maximum  — additionally removes nav, asides, site chrome, and
#              explicit comments / share / related blocks
cleaning_level: standard

# ── HTTP ────────────────────────────────────────────────────
http_concurrency: 10
http_timeout: 20.0          # seconds
retries_http: 3
max_redirects: 10
max_content_size: 26214400  # 25 MiB in bytes

# ── Browser (Camoufox) ──────────────────────────────────────
browser_concurrency: 4
browser_timeout: 45.0       # seconds
retries_browser: 2

# Maximum bytes for ``extract(screenshot=…)`` captures. Oversized
# screenshots are discarded with a warning so the SQLite cache stays
# small. Comment in to override the 50 MiB default.
# screenshot_max_bytes: 52428800

# ── Proxy ───────────────────────────────────────────────────
# Provider:  none  |  custom  |  decodo  |  byteful
#
# • ``custom`` — any standard HTTP, HTTPS, or SOCKS5 proxy you
#   control or rent (datacenter, corporate gateway, Tor, etc.).
#   Read the URL from ``CUSTOM_PROXY_URL`` (env var).  The URL
#   is passed through verbatim — no username rewriting.
#
# • ``decodo`` — residential provider.  Read the URL from
#   ``DECODO_PROXY_URL`` (env var).  ``session_rotation``
#   (sticky | rotate) controls how often the session ID changes.
#
# • ``byteful`` — residential provider.  Read the URL from
#   ``BYTEFUL_PROXY_URL`` (env var).  Same ``session_rotation``
#   semantics; the session ID is appended as ``_s_<id>``.
#
# Examples (interpolated from environment variables):
#   CUSTOM_PROXY_URL=socks5://user:pass@proxy.example.com:1080
#   DECODO_PROXY_URL=http://user:pass@residential.decodo.com:8000
#   BYTEFUL_PROXY_URL=https://user:pass@residential.byteful.com:8000
proxy: none

# Session rotation for residential (``decodo``, ``byteful``) providers.
#   sticky — same exit IP per domain (default)
#   rotate — new exit IP per request
session_rotation: sticky

# ── Cache ───────────────────────────────────────────────────
cache_enabled: true
cache_ttl: 24h               # s, m, h, d  suffixes accepted
# cache_path: ./pagefetch-cache.sqlite3  # default uses the native user cache directory

# ── Error handling ──────────────────────────────────────────
raise_on_error: false
