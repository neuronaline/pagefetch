# ─────────────────────────────────────────────────────────────
# PageFetch  configuration  (copy to  config.yaml  and edit)
# ─────────────────────────────────────────────────────────────
#
# Values support  ${ENV_VAR}  and  ${ENV_VAR:default}  syntax.
# Environment variables are resolved from  .env  or the shell.
# ─────────────────────────────────────────────────────────────

# ── Extraction & Content ────────────────────────────────────
# Confidence threshold (0.0 – 1.0) used during challenge/completeness scoring.
confidence_threshold: 0.80

# How aggressively to strip non-content DOM before extraction.
#   minimal  — only universally safe rules (display:none, hidden, 1×1 pixels)
#   standard — also drops cookie banners, ad slots, tracking pixels (default)
#   maximum  — additionally removes nav, asides, site chrome, and
#              explicit comments / share / related blocks
cleaning_level: standard

# ── Browser (Camoufox) ──────────────────────────────────────
concurrency: 4
timeout: 45.0               # seconds
retries: 2
max_content_size: 26214400  # 25 MiB in bytes

# Maximum bytes for ``extract(screenshot=…)`` captures. Oversized
# screenshots are discarded with a warning so the SQLite cache stays
# small. Comment in to override the 50 MiB default.
# screenshot_max_bytes: 52428800

# Multiplicative byte margin over max_content_size for browser pre-render checks
# pre_check_byte_margin: 1.5

# Number of requests served by a browser process before recycling (default: 50)
# max_requests: 50

# Idle timeout (seconds or duration string) before closing an unused browser process
# idle_ttl: 180s

# Full-page main-window scroll bounds (every browser navigation scrolls to bottom)
max_scroll_steps: 25
max_scroll_height: 150000

# Automatically expand in-page 'Read more' buttons, accordions, and dynamic tabs
expand: true

# ── Stealth & Anti-Detection ────────────────────────────────
# Anti-detection preset: off | balanced | max
#   off      — humanize=false, block_level=aggressive, block_images=true,  request_pacing=0.0, session_rotation=sticky
#   balanced — humanize=true,  block_level=balanced,   block_images=false, request_pacing=0.5, session_rotation=sticky (default)
#   max      — humanize=true,  block_level=minimal,    block_images=false, request_pacing=2.0, session_rotation=rotate
# Explicitly set options below override the preset values.
stealth_level: balanced

# Add small randomized delays to mimic human interaction
# humanize: true

# Resource blocking aggressiveness: minimal | balanced | aggressive
# block_level: balanced

# Block images in browser mode (saves bandwidth; auto-disabled in balanced/max stealth)
# block_images: false

# Value sent as the Accept-Language header (explicit non-default values override proxy GeoIP locale)
accept_language: "en-US,en;q=0.5"

# Seconds of delay between requests per host (0.0 = none)
# request_pacing: 0.5

# ── Proxy ───────────────────────────────────────────────────
# Provider:  none  |  custom  |  decodo  |  byteful
#
# • ``custom`` — any standard HTTP, HTTPS, or SOCKS5 proxy you
#   control or rent (datacenter, corporate gateway, Tor, etc.).
#   Read the URL from ``CUSTOM_PROXY_URL`` (fallback ``PROXY_URL``).
#   The URL is passed through verbatim — no username rewriting.
#
# • ``decodo`` — residential provider.  Read the URL from
#   ``DECODO_PROXY_URL`` (env var).  ``session_rotation``
#   (sticky | rotate) controls how often the session ID changes.
#
# • ``byteful`` — residential provider.  Read the URL from
#   ``BYTEFUL_PROXY_URL`` (env var).  Same ``session_rotation``
#   semantics; the session ID is appended as ``_s_<id>``.
#
# Examples (interpolated from environment variables):
#   CUSTOM_PROXY_URL=socks5://user:pass@proxy.example.com:1080
#   DECODO_PROXY_URL=http://user:pass@residential.decodo.com:8000
#   BYTEFUL_PROXY_URL=https://user:pass@residential.byteful.com:8000
proxy: none

# Session rotation for residential (``decodo``, ``byteful``) providers.
#   sticky — same exit IP per domain (default)
#   rotate — new exit IP per request
session_rotation: sticky

# Optional sticky-session TTL forwarded to the residential provider
# (DECODO_DOCS §4, BYTEFUL_DOCS §4).  When set, the matching documented
# token is appended during sticky-session injection:
#   • Decodo  → ``-sessionduration-<minutes>`` (1–1440 minutes)
#   • Byteful → ``_ttl_<n><unit>``         (1 minute – 7 days)
# Accepted values: ``"30m"``, ``"2h"``, ``"1d"`` or an integer-seconds
# count.  Comment out to use the provider's documented default behavior.
# session_duration: 30m

# ── Cache ───────────────────────────────────────────────────
cache_enabled: true
cache_ttl: 24h               # s, m, h, d  suffixes accepted
# cache_path: ./pagefetch-cache.sqlite3  # default uses the native user cache directory

# ── Custom Headers & Cookies ────────────────────────────────
# Default headers and cookies/cookie-pool applied across requests.
# ``cookie_file`` accepts a Netscape cookies.txt file or a line-delimited
# raw Cookie header file.
# headers:
#   Authorization: "Bearer ${API_TOKEN}"
#   X-Custom-Client: "pagefetch-app"
# cookie_file: ./cookies.txt
# cookie_cooldown: 120.0
# cookies:
#   session_token: "example_token_value"

# ── Error handling ──────────────────────────────────────────
raise_on_error: false
